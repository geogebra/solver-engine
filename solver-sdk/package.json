{
  "name": "@geogebra/solver-sdk",
  "version": "3.35.0-main.5",
  "description": "Provides a convenient interface for the GGB Solver API.",
  "main": "lib/cjs/index.js",
  "module": "lib/esm/index.js",
  "types": "lib/esm/index.d.ts",
  "files": [
    "lib",
    "dist",
    "src",
    "test"
  ],
  "scripts": {
    "build": "npm run build:esm && npm run build:cjs && npm run build:web",
    "build:esm": "tsc",
    "build:cjs": "tsc -p tsconfig-cjs.json",
    "build:web": "vite build",
    "watch": "tsc --watch",
    "start": "vite --host",
    "test": "vitest run --coverage",
    "test-watch": "vitest",
    "test-watch-full": "vitest --coverage",
    "semantic-release": "semantic-release",
    "prettier": "cd .. && prettier -w ."
  },
  "publishConfig": {
    "access": "restricted"
  },
  "contributors": [
    "Erik Weitnauer <erik.weitnauer@geogebra.at>"
  ],
  "license": "ISC",
  "volta": {
    "node": "22.22.2"
  },
  "devDependencies": {
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/gitlab": "^13.3.3",
    "@semantic-release/npm": "^13.1.5",
    "@types/jsdom": "^30.0.0",
    "@typescript-eslint/eslint-plugin": "^5.60.1",
    "@typescript-eslint/parser": "^5.60.1",
    "@vitest/coverage-v8": "^4.1.11",
    "cross-fetch": "^3.1.6",
    "dotenv": "^16.3.1",
    "eslint": "^8.43.0",
    "eslint-config-prettier": "^8.8.0",
    "jsdom": "^30.0.1",
    "lodash": "^4.18.1",
    "node-fetch": "^3.3.1",
    "prettier": "^3.9.6",
    "require-from-url": "^3.1.3",
    "semantic-release": "^24.2.9",
    "typescript": "^5.1.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
